<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- the product a part draws from stock; librefleet keeps the field off its list -->
    <record id="view_librefleet_part_list_stock" model="ir.ui.view">
        <field name="name">librefleet.part.list.stock</field>
        <field name="model">librefleet.part</field>
        <field name="inherit_id" ref="librefleet.view_librefleet_part_list"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="product_id"/>
            </field>
        </field>
    </record>
</odoo>
