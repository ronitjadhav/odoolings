<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_librefleet_service_order_list" model="ir.ui.view">
        <field name="name">librefleet.service.order.list</field>
        <field name="model">librefleet.service.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="stage == 'cancelled'"
                  decoration-success="stage == 'done'"
                  decoration-info="stage == 'in_progress'">
                <field name="reference"/>
                <field name="vehicle_id"/>
                <field name="customer_id" optional="hide"/>
                <field name="service_type_id" optional="show"/>
                <field name="scheduled_start"/>
                <field name="technician_ids" widget="many2many_tags"/>
                <field name="stage" widget="badge"
                       decoration-success="stage == 'done'"
                       decoration-info="stage in ('confirmed', 'in_progress')"/>
            </list>
        </field>
    </record>

    <record id="view_librefleet_service_order_form" model="ir.ui.view">
        <field name="name">librefleet.service.order.form</field>
        <field name="model">librefleet.service.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage" widget="statusbar"
                           options="{'clickable': true}"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <h1><field name="reference" readonly="1"/></h1>
                    <group>
                        <group string="What and for whom">
                            <field name="vehicle_id"/>
                            <field name="customer_id"/>
                            <field name="service_type_id"/>
                            <field name="technician_ids" widget="many2many_tags"/>
                        </group>
                        <group string="When">
                            <field name="scheduled_start" widget="daterange"
                                   options="{'end_date_field': 'scheduled_end'}"/>
                            <field name="scheduled_end" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parts" name="parts">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="part_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                            <group>
                                <group/>
                                <group string="Money">
                                    <field name="parts_total"/>
                                    <field name="labor_total"/>
                                    <field name="margin" groups="librefleet.group_librefleet_manager"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Diagnosis, customer requests, anything the invoice should remember..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_librefleet_service_order_search" model="ir.ui.view">
        <field name="name">librefleet.service.order.search</field>
        <field name="model">librefleet.service.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="vehicle_id"/>
                <field name="customer_id"/>
                <field name="technician_ids"/>
                <filter string="My Services" name="my_services"
                        domain="[('technician_ids', 'in', [uid])]"/>
                <filter string="Exclude Cancelled" name="not_cancelled"
                        domain="[('stage', '!=', 'cancelled')]"/>
                <separator/>
                <filter string="Draft" name="stage_draft" domain="[('stage', '=', 'draft')]"/>
                <filter string="Confirmed" name="stage_confirmed" domain="[('stage', '=', 'confirmed')]"/>
                <filter string="In Progress" name="stage_in_progress" domain="[('stage', '=', 'in_progress')]"/>
                <filter string="Done" name="stage_done" domain="[('stage', '=', 'done')]"/>
                <!-- Group By -->
                <group>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage'}"/>
                    <filter string="Service Type" name="group_service_type" context="{'group_by': 'service_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_librefleet_service_order" model="ir.actions.act_window">
        <field name="name">Service Orders</field>
        <field name="res_model">librefleet.service.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book the first service</p>
            <p>A service order is one vehicle, one visit: what gets done, by whom, and which parts it takes.</p>
        </field>
    </record>

</odoo>
