<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garage_inventory_item_list" model="ir.ui.view">
        <field name="name">garage.inventory.item.list</field>
        <field name="model">garage.inventory.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="qty_on_hand"/>
                <field name="total_value"/>
            </list>
        </field>
    </record>

    <record id="view_garage_inventory_item_form" model="ir.ui.view">
        <field name="name">garage.inventory.item.form</field>
        <field name="model">garage.inventory.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="qty_on_hand"/>
                            <field name="unit_cost"/>
                            <field name="total_value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garage_inventory_item" model="ir.actions.act_window">
        <field name="name">Inventory Items</field>
        <field name="res_model">garage.inventory.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first inventory item</p>
        </field>
    </record>

    <menuitem id="menu_garage_root" name="Garage"/>
    <menuitem id="menu_garage_items" name="Inventory Items"
              parent="menu_garage_root" action="action_garage_inventory_item"/>

</odoo>
