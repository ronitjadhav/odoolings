<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_garage" model="res.groups.privilege">
        <field name="name">Garage</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_garage_stockkeeper" model="res.groups">
        <field name="name">Stockkeeper</field>
        <field name="privilege_id" ref="privilege_garage"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Stockkeepers manage the garage parts inventory.</field>
    </record>

</odoo>
